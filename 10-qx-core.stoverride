# ==========================================================================
# 10-qx-core.stoverride
# QX -> Stash 迁移 · 核心覆写（策略组 / 规则集 / 规则 / DNS）
#
# 语义：本文件用 `#!replace` 完整替换机场原有的
#   proxy-groups / rule-providers / rules / dns 四个顶层键，
#   在保留机场 84 个 proxies 不变的前提下重建一套精简核心配置。
#
# 绝不触碰：proxies / proxy-providers / 节点协议字段（不含任何 #!replace proxies）
# 不含：YouTube Rewrite / TikTok Rewrite / MITM 证书 / p12 / passphrase
# ==========================================================================
name: 10-qx-core
desc: "QX->Stash 核心：精简策略组/规则/DNS（保留机场84节点，不覆写Sniffer）"

# ==========================================================================
# 策略组：22 个（select×21 + url-test×1；fallback=0 load-balance=0）
# 地区/专线节点用 Stash 官方确认的 include-all + filter 动态引用；
# 主选择组只引用精简子组，所有 select 组 interval=-1 关闭周期测速。
# ==========================================================================
proxy-groups: #!replace
  # ---- 主选择 ----
  - name: 🚀 节点选择
    type: select
    interval: -1
    proxies: [⚡ 自动选择, 🛩 专线节点, 🇭🇰 香港节点, 🇼🇸 台湾节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇺🇸 美国节点, DIRECT]

  # ---- 唯一自动测速组（url-test）----
  - name: ⚡ 自动选择
    type: url-test
    include-all: true
    interval: 1800
    lazy: true

  # ---- 专线（IEPL/IPLC/AI-Prime）----
  - name: 🛩 专线节点
    type: select
    interval: -1
    include-all: true
    filter: "IEPL|IPLC|专线|专線|AI-Prime"

  # ---- 地区组（全部 select + filter）----
  - name: 🇭🇰 香港节点
    type: select
    interval: -1
    include-all: true
    filter: "香港|HongKong|Hong Kong|HK|🇭🇰"
  - name: 🇼🇸 台湾节点
    type: select
    interval: -1
    include-all: true
    filter: "台湾|台灣|臺灣|Taiwan|TW|🇹🇼|🇼🇸"
  - name: 🇯🇵 日本节点
    type: select
    interval: -1
    include-all: true
    filter: "日本|Japan|JP|🇯🇵"
  - name: 🇸🇬 新加坡节点
    type: select
    interval: -1
    include-all: true
    filter: "新加坡|Singapore|SG|🇸🇬"
  - name: 🇺🇸 美国节点
    type: select
    interval: -1
    include-all: true
    filter: "美国|美國|United States|USA|US|🇺🇸"

  # ---- 业务分流组（引用上面的选择/自动/地区组）----
  - name: 🤖 AI平台
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇼🇸 台湾节点, 🇭🇰 香港节点, DIRECT]
  - name: 📹 YouTube
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇭🇰 香港节点, 🇼🇸 台湾节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇺🇸 美国节点, DIRECT]
  - name: 🌐 Google
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇭🇰 香港节点, 🇼🇸 台湾节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇺🇸 美国节点, DIRECT]
  - name: 💰 加密与交易
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇭🇰 香港节点, DIRECT]
  # Binance 独立组：DIRECT 首位保持默认直连，同时允许在 Stash 中手动切换代理
  - name: 🟡 Binance
    type: select
    interval: -1
    proxies: [DIRECT, 🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇭🇰 香港节点, 🇼🇸 台湾节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇺🇸 美国节点]
  - name: 📲 Telegram
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇸🇬 新加坡节点, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, DIRECT]
  - name: 🐦 社交媒体
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇭🇰 香港节点, 🇼🇸 台湾节点, DIRECT]
  - name: 🍎 Apple
    type: select
    interval: -1
    proxies: [DIRECT, 🚀 节点选择, ⚡ 自动选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点]
  - name: 🎬 流媒体
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇭🇰 香港节点, 🇼🇸 台湾节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇺🇸 美国节点, DIRECT]
  - name: 🎮 游戏平台
    type: select
    interval: -1
    proxies: [🚀 节点选择, DIRECT, ⚡ 自动选择, 🛩 专线节点, 🇭🇰 香港节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇺🇸 美国节点]
  - name: 📥 下载
    type: select
    interval: -1
    proxies: [DIRECT, 🚀 节点选择, ⚡ 自动选择]

  # ---- 兜底 / 直连 / 广告 ----
  - name: 🇨🇳 中国大陆
    type: select
    interval: -1
    proxies: [DIRECT, 🚀 节点选择]
  - name: 🐟 漏网之鱼
    type: select
    interval: -1
    proxies: [🚀 节点选择, ⚡ 自动选择, 🛩 专线节点, 🇭🇰 香港节点, 🇼🇸 台湾节点, 🇯🇵 日本节点, 🇸🇬 新加坡节点, 🇺🇸 美国节点, DIRECT]
  - name: 🛑 广告拦截
    type: select
    interval: -1
    proxies: [REJECT, DIRECT, 🚀 节点选择]

# ==========================================================================
# 规则集：36 个（27 域名 mrs + 2 分类 yaml[crypto/download] + 7 IP mrs），全部被 rules 引用
#   download 改用 blackmatrix7(classical)、steam_ip 已删除：原 MetaCubeX 对应文件均 404
# ==========================================================================
rule-providers: #!replace
  # -- 直连/广告 --
  private_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/private.mrs" }
  anti_ad_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/privacy-protection-tools/anti-ad.github.io/master/docs/mihomo.mrs" }
  # -- AI（专项 openai 在前，广义 ai 在后）--
  openai:            { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/openai.mrs" }
  ai:                { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/category-ai-!cn.mrs" }
  # -- 常规服务 --
  github_domain:     { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/github.mrs" }
  youtube_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/youtube.mrs" }
  google_domain:     { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/google.mrs" }
  # download：MetaCubeX geosite/category-download.mrs 已下线(404)，改用 QX 原始来源 blackmatrix7 Download（classical/yaml）
  download_domain:   { type: http, behavior: classical, format: yaml, interval: 86400, url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Download/Download.yaml" }
  microsoft_domain:  { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/microsoft.mrs" }
  onedrive_domain:   { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/onedrive.mrs" }
  appletv_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/apple-tvplus.mrs" }
  apple_domain:      { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/apple.mrs" }
  tiktok_domain:     { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/tiktok.mrs" }
  twitter_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/twitter.mrs" }
  telegram_domain:   { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/telegram.mrs" }
  # -- 加密货币：机场无对应，保留 QX 有效差集（blackmatrix7 Clash 兼容版）--
  crypto_domain:     { type: http, behavior: classical, format: yaml, interval: 86400, url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Cryptocurrency/Cryptocurrency.yaml" }
  # -- 流媒体 --
  netflix_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/netflix.mrs" }
  disney_domain:     { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/disney.mrs" }
  spotify_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/spotify.mrs" }
  # -- 游戏 --
  steam_domain:      { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/steam.mrs" }
  epic_domain:       { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/epicgames.mrs" }
  ea_domain:         { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/ea.mrs" }
  blizzard_domain:   { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/blizzard.mrs" }
  ubisoft_domain:    { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/ubisoft.mrs" }
  nintendo_domain:   { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/nintendo.mrs" }
  playstation_domain: { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/playstation.mrs" }
  xbox_domain:       { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/xbox.mrs" }
  # -- 兜底域名 --
  geolocation-!cn:   { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/geolocation-!cn.mrs" }
  cn_domain:         { type: http, behavior: domain, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.mrs" }

  # -- IP 类 --
  private_ip:        { type: http, behavior: ipcidr, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/private.mrs" }
  google_ip:         { type: http, behavior: ipcidr, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/google.mrs" }
  apple_ip:          { type: http, behavior: ipcidr, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo-lite/geoip/apple.mrs" }
  netflix_ip:        { type: http, behavior: ipcidr, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/netflix.mrs" }
  telegram_ip:       { type: http, behavior: ipcidr, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/telegram.mrs" }
  twitter_ip:        { type: http, behavior: ipcidr, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/twitter.mrs" }
  # steam_ip 已移除：MetaCubeX geoip/steam.mrs 不存在(404)；Steam 由 steam_domain(geosite) 覆盖
  cn_ip:             { type: http, behavior: ipcidr, format: mrs, interval: 86400, url: "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.mrs" }

# ==========================================================================
# 规则：私网/直连例外在前 -> 广告 -> 专项 -> 通用 Provider -> IP -> 兜底 -> 单一 MATCH
# ==========================================================================
rules: #!replace
  # -- 私网 / 直连 --
  - RULE-SET,private_ip,DIRECT,no-resolve
  - RULE-SET,private_domain,DIRECT
  - IP-CIDR,224.0.0.0/4,DIRECT,no-resolve
  - IP-CIDR6,fe80::/10,DIRECT,no-resolve
  # -- 自建域名 / 银行 / 国内例外（DIRECT，置于通用 Provider 之前）--
  - DOMAIN-SUFFIX,blackyoke.top,DIRECT
  - DOMAIN-SUFFIX,95599.cn,DIRECT
  - DOMAIN-SUFFIX,ccb.com,DIRECT
  - DOMAIN-SUFFIX,ccb.com.cn,DIRECT
  - DOMAIN-SUFFIX,ccb.cn,DIRECT
  - DOMAIN-SUFFIX,abchina.com,DIRECT
  - DOMAIN-SUFFIX,taobao.com,DIRECT
  # -- 游戏例外（DIRECT）--
  - DOMAIN-SUFFIX,supercell.com,DIRECT
  - DOMAIN-SUFFIX,clashroyale.com,DIRECT
  # -- Binance 独立组（必须在 crypto_domain Provider 之前，避免被通用加密货币规则提前匹配）--
  - DOMAIN-SUFFIX,binance.com,🟡 Binance
  - DOMAIN-KEYWORD,binance,🟡 Binance
  # -- 广告拦截（尽量靠前）--
  - RULE-SET,anti_ad_domain,🛑 广告拦截
  # -- 加密与交易：CoinGlass / TradingView 明确规则 --
  - DOMAIN-SUFFIX,cg-app-api.com,💰 加密与交易
  - DOMAIN-SUFFIX,cg-capi.com,💰 加密与交易
  - DOMAIN-SUFFIX,cg-mapi.com,💰 加密与交易
  - DOMAIN-KEYWORD,tradingview,💰 加密与交易
  # -- AI：Gemini 明确域名在 Google 之前；OpenAI 专项在广义 ai 之前 --
  - DOMAIN,gemini.google.com,🤖 AI平台
  - RULE-SET,openai,🤖 AI平台
  - RULE-SET,ai,🤖 AI平台
  # -- 常规服务分流 --
  - RULE-SET,github_domain,🚀 节点选择
  - RULE-SET,youtube_domain,📹 YouTube
  - RULE-SET,google_domain,🌐 Google
  - RULE-SET,download_domain,📥 下载
  - RULE-SET,microsoft_domain,🚀 节点选择
  - RULE-SET,onedrive_domain,🚀 节点选择
  - RULE-SET,appletv_domain,🍎 Apple
  - RULE-SET,apple_domain,🍎 Apple
  - RULE-SET,tiktok_domain,🐦 社交媒体
  - RULE-SET,twitter_domain,🐦 社交媒体
  - RULE-SET,telegram_domain,📲 Telegram
  - RULE-SET,crypto_domain,💰 加密与交易
  - RULE-SET,netflix_domain,🎬 流媒体
  - RULE-SET,disney_domain,🎬 流媒体
  - RULE-SET,spotify_domain,🎬 流媒体
  - RULE-SET,steam_domain,🎮 游戏平台
  - RULE-SET,epic_domain,🎮 游戏平台
  - RULE-SET,ea_domain,🎮 游戏平台
  - RULE-SET,blizzard_domain,🎮 游戏平台
  - RULE-SET,ubisoft_domain,🎮 游戏平台
  - RULE-SET,nintendo_domain,🎮 游戏平台
  - RULE-SET,playstation_domain,🎮 游戏平台
  - RULE-SET,xbox_domain,🎮 游戏平台
  # -- QX 本地保留的定向域名 --
  - DOMAIN-SUFFIX,dmm.co.jp,🇯🇵 日本节点
  - DOMAIN-SUFFIX,voachinese.com,🚀 节点选择
  - DOMAIN-KEYWORD,merlinblog,🚀 节点选择
  - DOMAIN-SUFFIX,cloudflare-dns.com,🚀 节点选择
  - DOMAIN-SUFFIX,dns.google,🚀 节点选择
  # -- IP 类 Provider（no-resolve）--
  - RULE-SET,google_ip,🌐 Google,no-resolve
  - RULE-SET,apple_ip,🍎 Apple,no-resolve
  - RULE-SET,netflix_ip,🎬 流媒体,no-resolve
  - RULE-SET,telegram_ip,📲 Telegram,no-resolve
  - RULE-SET,twitter_ip,🐦 社交媒体,no-resolve
  # -- 兜底 --
  - RULE-SET,geolocation-!cn,🐟 漏网之鱼
  - RULE-SET,cn_domain,🇨🇳 中国大陆
  - RULE-SET,cn_ip,🇨🇳 中国大陆,no-resolve
  - MATCH,🐟 漏网之鱼

# ==========================================================================
# DNS：仅保留 Stash 官方文档/官方示例确认的字段
#   default≤2 / nameserver≤2 / fake-ip-filter≤30；不迁移 QX 大型 DNS 列表
# ==========================================================================
dns: #!replace
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  follow-rule: false
  fake-ip-filter:
    - localhost
    - "*.lan"
    - "*.local"
    - "*.localdomain"
    - "*.home.arpa"
    - "stun.*.*"
    - "stun.*.*.*"
    - "time.*.com"
    - "time.*.gov"
    - "time.*.edu.cn"
    - "*.ntp.org.cn"
    - "pool.ntp.org"
    - "*.pool.ntp.org"
    - "ntp.aliyun.com"
    - "*.push.apple.com"
    - "+.blackyoke.top"
    - "+.95599.cn"
    - "+.ccb.com"
    - "+.abchina.com"
    - "+.cmbchina.com"
    - "+.pingan.com.cn"
    - "+.icbc.com.cn"
    - "captive.apple.com"
    - "*.msftconnecttest.com"
    - "*.msftncsi.com"
    - "+.n.n.srv.nintendo.net"
    - "+.stun.playstation.net"
    - "xbox.*.*.microsoft.com"
    - "*.*.xboxlive.com"

# ==========================================================================
# ==========================================================================
