# ==========================================================================
# 30-qx-tiktok.stoverride
# QX -> Stash 迁移 · TikTok 解锁 request script（独立可选，关闭后不影响核心代理）
#
# 来源：qx.conf [rewrite_local] 4 条 + [mitm] hostname（仅 TikTok 相关 3 个）
#
# 仅贡献 http.mitm / http.script / script-providers；不含 proxies / proxy-groups / rules / dns；
# 不迁移 QX p12 / passphrase，MITM 使用 Stash 自签 CA（由用户自行生成并信任）。
#
# Stash 官方文档未确认 URL Rewrite 捕获组替换语法，因此不再猜测 $1 / ${1}。
# 使用官方确认的 request JavaScript + $done({url}) 逐条复现 qx.conf 四条规则。
# ⚠ payload 需要 Stash 3.2.5+；脚本和区域解锁效果仍未在 iPhone 真机验证。
# ==========================================================================
name: 30-qx-tiktok
desc: "TikTok 解锁（MITM + request JavaScript）· Stash 3.2.5+ · 真机 UNVERIFIED"

http:
  # -- MITM 主机名（仅审计确认的 3 个 TikTok 域）--
  mitm:
    - "*.tiktokv.com"
    - "*.byteoversea.com"
    - "*.tik-tokapi.com"

  # -- 仅在三个 MITM 域的请求上运行；不读取或修改 body --
  script:
    - match: ^https?:\/\/[^\/]+\.(?:tiktokv|byteoversea|tik-tokapi)\.com\/
      name: tiktok_region_request
      type: request
      timeout: 5

# Stash 3.2.5+ 官方支持内嵌 payload。脚本不记录 URL、Token、Cookie 或认证参数。
script-providers:
  tiktok_region_request:
    payload: |
      (() => {
        let url = $request.url;
        const original = url;

        // (1) (?<=_region=)CN(?=&) -> JP
        url = url.replace(/(_region=)CN(?=&)/, (_, prefix) => prefix + "JP");

        // (2) (?<=&mcc_mnc=)4 -> 2
        url = url.replace(/(&mcc_mnc=)4/, (_, prefix) => prefix + "2");

        // (3) 原 QX $1$3：保留问号，删除问号后的匹配内容
        url = url.replace(
          /^(https?:\/\/(?:tnc|dm)[\w-]+\.\w+\.com\/.+)(\?)(.+)/,
          (_, before, question) => before + question
        );

        // (4) (?<=\d\/\?\w{7}_\w{4}=)1[6-9]..(?=.?.?&) -> 17
        url = url.replace(
          /(\d\/\?\w{7}_\w{4}=)1[6-9]..(?=.?.?&)/,
          (_, prefix) => prefix + "17"
        );

        $done(url === original ? {} : { url });
      })();
